<% layout('layouts/boilerplate')%>
<div class="d-flex justify-content-between align-items-center mb-4">
  <div>
    <h1>Lucknow Hotel Listings</h1>
    <p class="text-light">Location locked to Lucknow, Uttar Pradesh.</p>
  </div>
  <a href="/ads/new" class="btn btn-info">Add Lucknow Hotel</a>
</div>

<div class="mb-4">
  <div class="btn-group flex-wrap" role="group">
    <a href="/ads" class="btn <%= selectedCategory === 'all' ? 'btn-info' : 'btn-outline-info' %>">All Platforms</a>
    <% platforms.forEach((platform) => { %>
      <a href="/ads?category=<%= encodeURIComponent(platform) %>" class="btn <%= selectedCategory === platform ? 'btn-info' : 'btn-outline-info' %>"><%= platform %></a>
    <% }) %>
  </div>
</div>

<div class="row g-4">
  <% ads.forEach((ad) => { %>
    <div class="col-md-6 col-lg-4">
      <div class="card glass-card hotel-card h-100 text-light">
        <img class="card-img-top" src="<%= ad.images.length ? ad.images[0].url : '/Images/no-image.png' %>" alt="Hotel image" style="height:220px;object-fit:cover;" />
        <div class="card-body">
          <span class="badge bg-info mb-2"><%= ad.category %></span>
          <h5><%= ad.title %></h5>
          <p class="mb-2"><%= ad.location %></p>
          <p class="mb-3">₹<%= ad.price %> / night</p>
          <a class="btn btn-outline-light" href="/ads/<%= ad._id %>">Compare Reviews</a>
        </div>
      </div>
    </div>
  <% }) %>
</div>
