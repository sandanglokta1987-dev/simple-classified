<% layout('layouts/boilerplate')%>
<div class="glass-card p-4 mb-4">
  <div class="row g-4">
    <div class="col-md-5">
      <img class="img-fluid rounded" src="<%= ad.images.length ? ad.images[0].url : '/Images/no-image.png' %>" alt="Hotel image" />
    </div>
    <div class="col-md-7">
      <span class="badge bg-info mb-2"><%= ad.category %></span>
      <h2><%= ad.title %></h2>
      <p><strong>City:</strong> <%= ad.location %></p>
      <p><%= ad.description %></p>
      <h4>₹<%= ad.price %> / night</h4>
      <p class="text-info">Average review score: <strong><%= avgRating %>/5</strong></p>
      <% if(currentUser && ad.author.equals(currentUser._id)) { %>
        <a class="btn btn-outline-light" href="/ads/<%= ad._id %>/edit">Edit</a>
        <form class="d-inline" action="/ads/<%= ad._id %>?_method=DELETE" method="POST">
          <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
          <button class="btn btn-danger">Delete</button>
        </form>
      <% } %>
    </div>
  </div>
</div>

<div class="glass-card p-4">
  <h3>Review Comparison (Lucknow Hotel)</h3>
  <div class="row g-3 mt-1">
    <% ad.platformReviews.forEach((review) => { %>
      <div class="col-md-6">
        <div class="p-3 border rounded h-100">
          <h5><%= review.platform %> <span class="badge bg-success"><%= review.rating %>/5</span></h5>
          <p class="mb-0">“<%= review.quote %>”</p>
        </div>
      </div>
    <% }) %>
  </div>
</div>
