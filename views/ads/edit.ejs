<% layout('layouts/boilerplate')%>
<div class="row">
  <div class="col-md-8 offset-md-2 glass-card p-4">
    <h2>Edit Lucknow Hotel Listing</h2>
    <form action="/ads/<%= ad._id %>?_method=PUT<% if (csrfToken) { %>&_csrf=<%= encodeURIComponent(csrfToken) %><% } %>" method="POST" class="validated-form" enctype="multipart/form-data" novalidate>
      <% if (csrfToken) { %><input type="hidden" name="_csrf" value="<%= csrfToken %>" /><% } %>
      <div class="mb-3"><label class="form-label">Hotel Name</label><input class="form-control" name="Ad[title]" value="<%= ad.title %>" required /></div>
      <div class="mb-3"><label class="form-label">Location (fixed)</label><input class="form-control" name="Ad[location]" value="Lucknow, Uttar Pradesh" readonly /></div>
      <div class="mb-3"><label class="form-label">Primary Platform</label>
        <select class="form-control" name="Ad[category]" required>
          <% platforms.forEach((platform) => { %><option value="<%= platform %>" <%= ad.category === platform ? 'selected' : '' %>><%= platform %></option><% }) %>
        </select>
      </div>
      <div class="mb-3"><label class="form-label">Price Per Night (₹)</label><input class="form-control" type="number" min="0" name="Ad[price]" value="<%= ad.price %>" required /></div>
      <div class="mb-3"><label class="form-label">Description</label><textarea class="form-control" name="Ad[description]" required><%= ad.description %></textarea></div>
      <div class="mb-3"><input type="file" class="form-control" name="image" multiple /></div>
      <button class="btn btn-info">Save Changes</button>
    </form>
  </div>
</div>
